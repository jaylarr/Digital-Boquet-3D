{
  "name": "petalpop-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "tsc -b && vite build --configLoader native",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "start": "node server/index.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --configLoader native",
    "test:e2e": "playwright test",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "cf:types": "wrangler types cloudflare/worker-configuration.d.ts --config cloudflare/wrangler.jsonc",
    "cf:typecheck": "tsc --project cloudflare/tsconfig.json --noEmit --incremental false",
    "cf:migrate:local": "wrangler d1 migrations apply BOUQUET_SHARES --local --config cloudflare/wrangler.jsonc --persist-to .checks/cloudflare/state",
    "cf:dev": "wrangler dev --local --config cloudflare/wrangler.jsonc --port 8787 --persist-to .checks/cloudflare/state",
    "cf:check": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc --outdir ../.checks/cloudflare/build",
    "test:cf-sharing": "node scripts/verify-cloudflare-sharing.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "lucide-react": "^0.468.0",
    "lz-string": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0",
    "wrangler": "4.152.0"
  }
}
