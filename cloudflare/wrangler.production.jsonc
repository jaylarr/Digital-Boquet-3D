{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bouquetforyou-share-api",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "d1_databases": [
    {
      "binding": "BOUQUET_SHARES",
      "database_name": "bouquetforyou-shares",
      "migrations_dir": "./migrations",
      "database_id": "9c183d0d-328d-42d6-b603-b9c8bcbf7733"
    }
  ],
  "account_id": "08632a6b9dd841753311d078d691f1fd",
  "routes": [
    {
      "pattern": "bouquetforyou.lar-ykt.com/api/bouquets*",
      "zone_name": "lar-ykt.com"
    }
  ]
}
